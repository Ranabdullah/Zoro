# Public frontend configuration only. These values appear in the browser bundle.
# Cloudflare Pages: enter these as build variables in your own project.
# npm run build does not read .env automatically; set shell variables for local builds.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY

# Never add SMTP passwords, database passwords or sb_secret/service-role keys here.
